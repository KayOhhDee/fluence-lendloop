# Copy to n8n/.env. Generate each secret with:  openssl rand -hex 32

# Encrypts n8n's stored credentials. Keep it stable: changing it locks n8n out of its own data.
N8N_ENCRYPTION_KEY=

# Convex -> n8n signing secret. Must equal N8N_WEBHOOK_SECRET in Convex.
LENDLOOP_WEBHOOK_SECRET=

# n8n -> Convex signing secret. Must equal CONVEX_INBOUND_SECRET in Convex.
LENDLOOP_INBOUND_SECRET=

# Where n8n reaches Convex HTTP actions.
#   Local Convex (npx convex dev --local):  http://host.docker.internal:3211
#   Convex cloud:                           https://<deployment>.convex.site
CONVEX_SITE_URL=http://host.docker.internal:3211

# Public URL of n8n, only if it differs from localhost (for example, your tunnel URL).
# N8N_PUBLIC_URL=https://example.trycloudflare.com/

# Set to true to make the mock senders fail, to watch retries and the error workflow.
LENDLOOP_SIMULATE_SEND_FAILURE=false
