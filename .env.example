# Copy to .env.local. `npx convex dev` fills in the Convex values for you.

# Convex
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# Clerk: https://dashboard.clerk.com -> API keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# The values below are NOT read from this file. They live on the Convex deployment, set with
# `npx convex env set NAME value`, and are listed here for reference only:
#
#   CLERK_JWT_ISSUER_DOMAIN  Your Clerk Frontend API URL, e.g. https://your-app.clerk.accounts.dev
#   N8N_WEBHOOK_URL          e.g. http://localhost:5678/webhook/lendloop-loan-events
#   N8N_WEBHOOK_SECRET       Must equal LENDLOOP_WEBHOOK_SECRET in n8n/.env
#   CONVEX_INBOUND_SECRET    Must equal LENDLOOP_INBOUND_SECRET in n8n/.env
